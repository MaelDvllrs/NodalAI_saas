# Exemple de fichier .env pour la production
# Copiez ce fichier en .env et remplissez avec vos vraies valeurs

# ===== SERVEUR =====
PORT=3001
NODE_ENV=production

# ===== SUPABASE =====
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_SERVICE_KEY=votre-service-key-ici
SUPABASE_ANON_KEY=votre-anon-key-ici
SUPABASE_STORAGE_BUCKET=blog-images

# ===== JWT =====
# Générez un secret aléatoire avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=votre-secret-jwt-super-securise-aleatoire

# ===== CLAUDE API (Anthropic) =====
ANTHROPIC_API_KEY=sk-ant-xxxxx

# ===== DATAFORSEO (Recherche de mots-clés) =====
DATAFORSEO_LOGIN=votre-login-dataforseo
DATAFORSEO_PASSWORD=votre-password-dataforseo

# ===== GEMINI API (Google - Génération d'images) =====
GEMINI_API_KEY=votre-gemini-api-key

# ===== CORS =====
# URL(s) de votre frontend (séparées par des virgules si plusieurs)
CORS_ORIGIN=https://votre-domaine.vercel.app

# ===== OPTIONNEL : Rate Limiting =====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
